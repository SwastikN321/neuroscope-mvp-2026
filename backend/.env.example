# Optional shell exports; no secrets. The service does not automatically load this file.
NEUROSCOPE_MAX_UPLOAD_BYTES=67108864
NEUROSCOPE_MAX_STORAGE_BYTES=268435456
NEUROSCOPE_MAX_RECORDINGS=4
NEUROSCOPE_TTL_SECONDS=3600
NEUROSCOPE_CLEANUP_INTERVAL=30
NEUROSCOPE_UPLOAD_TIMEOUT=30
NEUROSCOPE_MAX_WINDOW_SECONDS=30
NEUROSCOPE_MAX_WINDOW_VALUES=250000
NEUROSCOPE_MAX_SELECTED_CHANNELS=32

# Phase 4B.2A: OFF by default. Only enables a read-only, still-local metadata route.
# Do not enable before separate migration approval. Never use a service-role/secret key.
NEUROSCOPE_CLOUD_ENABLED=false
NEUROSCOPE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEUROSCOPE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
NEUROSCOPE_CLOUD_MAX_FILE_BYTES=50000000
