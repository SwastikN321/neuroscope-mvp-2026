# Copy to backend/.env.cloud.local (ignored). Source only into the backend process.
# Never prefix secret values with VITE_. Never paste keys into chat.
NEUROSCOPE_CLOUD_ENABLED=false
NEUROSCOPE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEUROSCOPE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEUROSCOPE_SUPABASE_SECRET_KEY=
NEUROSCOPE_CLOUD_TEST_USER_IDS=
NEUROSCOPE_CLOUD_RELEASE_APPROVED=false
NEUROSCOPE_CLOUD_MAX_FILE_BYTES=50000000
NEUROSCOPE_CLOUD_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NEUROSCOPE_CLOUD_HOSTS=127.0.0.1,localhost,[::1]
NEUROSCOPE_CLOUD_BIND=127.0.0.1
PORT=8001
