# Local-only Vite development proxy. Never use a remote target for EEG data.
# Default: http://127.0.0.1:8000. Only loopback HTTP hosts are accepted.
NEUROSCOPE_API_TARGET=http://127.0.0.1:8000
# Backend limits are documented separately in backend/.env.example.
# Optional account configuration. Leave blank for the guest-only build.
# Copy into .env.local; public client configuration is visible in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=http://127.0.0.1:5173
VITE_AUTH_CALLBACK_PATH=/auth/callback
# Use sb_publishable_... (or a legacy anon key), NEVER a service-role/secret key.
# Google/GitHub client secrets belong only in the Supabase dashboard.
# See AUTHENTICATION.md for redirect, email and provider setup.

# Private cloud workflow stays off until approved live security tests pass.
VITE_CLOUD_RECORDINGS_ENABLED=false
# Production: exact HTTPS origin of cloud-only FastAPI. Development uses localhost:8001 proxy.
VITE_CLOUD_API_ORIGIN=
